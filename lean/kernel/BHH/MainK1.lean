/-
The kernel-only proof, K1 (standard axioms only): `MainBoundsK1`, `BetaBoundK1` and `BHHBetaBoundK1` from leaf
soundness of the kernel-side leaf functions (`leafSound_K_final`, module D) and the kernel-checked trees of all 512 initial
boxes for `k = 3` and `k = 4` (`BHH/KSub`, sub-box shards generated by tools/gen_kcut.py).
-/
import BHH.MainK
import BHH.BetaK
import BHH.LeafSound.FinalK
import BHH.KSub.K3.Asm
import BHH.KSub.K4.Asm

namespace BHH

open BHH.KC

/-- The kernel-only proof, K1: `C_3 ≥ 0.0117028397` and `C_4 ≥ 0.0054272702`. -/
theorem mainBoundsK1 : MainBoundsK1 :=
  mainBoundsK1_of leafSound_K_final BHH.KSub.K3.range BHH.KSub.K4.range
    (by norm_num [piThreeHalvesLo, BHH.KSub.K3.S, BHH.Cert.OS])
    (by norm_num [piThreeHalvesLo, BHH.KSub.K4.S, BHH.Cert.OS])

/-- The kernel-only proof, K1: `β ≥ 0.6421301` for every `β ≥ 5/8 + Σ_{k=3}^{30} C_k`. -/
theorem betaBoundK1 : BetaBoundK1 := betaBoundK1_of mainBoundsK1

/-- The kernel-only proof, K1, for the BHH constant (with the theorem of Dong and Cao as a hypothesis). -/
theorem bhhBetaBoundK1 : BHHBetaBoundK1 := bhhBetaBoundK1_of betaBoundK1

end BHH
